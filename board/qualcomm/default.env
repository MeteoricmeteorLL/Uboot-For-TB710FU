stdin=serial,button-kbd
stdout=serial
stderr=serial
serverhostname=cymric
httpfile=u-boot-nodtb.bin.gz
dtbfile=dts/upstream/src/arm64/qcom/qrb4210-rb2.dtb
serverip=0.0.0.0
httpdstp=9000
autoload=0
wgetfile=wget ${kernel_addr_r} ${serverip}:${httpfile}
netboot=echo "Chainloading ${httpfile} from ${serverhostname}"; \
	dhcp; dns ${serverhostname} serverip && \
	echo "$ ${wgetfile}" && \
	run wgetfile && \
	echo "$ wget ${kernel_addr_r} ${serverip}:${dtbfile}" && \
	wget ${fdt_addr_r} ${serverip}:${dtbfile} && \
	booti ${kernel_addr_r} - ${fdt_addr_r};
flashxbl=echo "Flashing XBL from ${kernel_addr_r}..."; \
	mmc write ${kernel_addr_r} 0x00020000 0x114e;
preboot=;
fastboot=fastboot -l $fastboot_addr_r usb 0
do_boot=run usb_boot
usb_boot=scsi scan; usb start; sysboot scsi 0:1 any ${scriptaddr} /extlinux/extlinux.conf
bootmenu_0=Boot external media=run usb_boot
bootmenu_1=Boot internal UFS=run ufs_boot
bootmenu_2=Enable fastboot mode=run fastboot
bootmenu_3=Reset device=reset
menucmd=bootmenu
# TB710FU: start the fastboot gadget immediately so the PC can take over
# TB710FU: boot mainline Linux appended after U-Boot in this same boot.img
bootcmd=scsi scan; echo SCSI_DONE; scsi info
ufs_boot=scsi scan; sysboot scsi 0:1 any ${scriptaddr} /extlinux/extlinux.conf
